APP_NAME=commerce-orchestrator
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=auto

POSTGRES_DB=commerce
POSTGRES_USER=commerce_user
POSTGRES_PASSWORD=commerce_pass
